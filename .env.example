# Copy to `.env.local` for local secrets. Never commit real credentials.
# `.env` and `.env*.local` are gitignored.
#
# Contact form → email via Nodemailer + Gmail SMTP (free, open-source library)
# 1. Open Google Account of dyusolar@gmail.com
# 2. Enable 2-Step Verification
# 3. Create an App Password: https://myaccount.google.com/apppasswords
# 4. Paste the 16-char app password as SMTP_PASS (no spaces)
# 5. Add the same vars in Vercel → Project → Settings → Environment Variables

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dyusolar@gmail.com
SMTP_PASS=
CONTACT_TO_EMAIL=dyusolar@gmail.com
CONTACT_FROM_EMAIL=DYU Solar <dyusolar@gmail.com>
